# Email para User-Agent de Crossref/OpenAlex (políticas de cortesía).
# Sin esto, las consultas funcionan pero con rate-limits más agresivos.
SPA_USER_EMAIL=rogelio.perez@cimat.mx

# Carpeta raíz para outputs.
SPA_OUTPUT_DIR=./out

# Base de datos local (DuckDB).
SPA_DB_PATH=./data/spa.duckdb

# Logging.
SPA_LOG_LEVEL=INFO

# Habilitar el conector de Google Scholar (best-effort, puede fallar).
SPA_ENABLE_SCHOLAR=true

# Timeout por request HTTP (segundos).
SPA_HTTP_TIMEOUT=20
